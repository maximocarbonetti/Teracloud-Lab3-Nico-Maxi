# Ejemplo de valores para el entorno dev.
# Copiar a terraform.tfvars y completar. El archivo real NO se versiona
# (esta en .gitignore) porque contiene la contrasena de la base.

project_name = "lab3"
environment  = "dev"
aws_region   = "us-east-1"

# ---- Red ----
azs                  = ["us-east-1a", "us-east-1b"]
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# ---- DNS y certificado ----
domain_zone_name = "maxicarbonetti.ownboarding.teratest.net"
create_dns_zone  = false
app_record_name  = "alb.maxicarbonetti.ownboarding.teratest.net"

# ---- Base de datos ----
# OJO: MySQL fija la contrasena solo en la primera inicializacion del volumen
# EFS. Definir el valor definitivo ANTES del primer apply: cambiarlo despues
# actualiza Parameter Store pero no la base, y el frontend falla con
# ER_ACCESS_DENIED_ERROR.
db_name     = "app"
db_user     = "app_user"
db_password = "CAMBIAR"

# Directorio del EFS donde vive el datadir de MySQL. Cambiarlo fuerza a la base
# a reinicializarse desde cero con las credenciales actuales (se pierden datos).
mysql_data_path = "/mysql-v2"

# ---- CI/CD ----
# El pipeline escucha el repositorio de la APLICACION, no el de infraestructura:
# un cambio en un .tf o en un README no debe disparar un despliegue de la app.
github_repository_id = "maximocarbonetti/Teracloud-Lab3-app-Nico-Maxi"
github_branch        = "main"

# Compuerta de aprobacion manual entre el build y el despliegue a ECS
enable_manual_approval = true

# ---- Notificaciones ----
# Cada direccion recibe un mail de confirmacion de SNS que hay que aceptar;
# sin ese clic las notificaciones no llegan.
notification_emails = [
  "cragnocontact@gmail.com",
  "maximocarbonetti2002@gmail.com",
]

# ---- Objetivos de nivel de servicio (SLO) ----
slo_error_rate_pct      = 1 # SLO de exito del 99%
slo_latency_p99_seconds = 2
frontend_desired_count  = 2
